# Copy this file to .env and fill in values locally.
# Never commit or send .env; it contains the Yandex API key.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# For example, gpt://<folder-id>/aliceai-llm.
YANDEX_MODEL_URI=
# Optional specialized primary model for subject planning and course design, e.g. gpt://<folder-id>/yandexgpt-5.1
YANDEX_MODEL_URI_COURSE_DESIGN=
# Optional. A blank value uses Alice AI LLM Flash in this folder.
YANDEX_MODEL_URI_UNIVERSITY=
YANDEX_MODEL_URI_SCIENCE=
YANDEX_MODEL_URI_BUSINESS=
YANDEX_VECTOR_STORE_ID_RPD=
YANDEX_VECTOR_STORE_ID_BOOKS=
YANDEX_VECTOR_STORE_ID_HH=
# Applied professional activities and interview techniques.
YANDEX_VECTOR_STORE_ID_PRIKLAD=
YANDEX_VECTOR_STORE_ID_INTERVIEW=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Optional fast model for agent summaries, interview, fact-check and the rationale judge.
# A blank value uses Alice AI LLM Flash in this folder.
YANDEX_MODEL_URI_FLASH=
# Input token limit of the course models; requests are shrunk to 90 % of it before sending.
YANDEX_INPUT_TOKEN_LIMIT=32768
# Generation parameters (saved in every course version).
# Low temperature keeps drafts reproducible; 0..1.
YANDEX_TEMPERATURE=0.2
# Output limit for one discipline draft (tokens).
YANDEX_DRAFT_MAX_OUTPUT_TOKENS=9000
# Read long draft answers as a stream so slow generation is not cut off; 0 disables.
YANDEX_STREAM_LONG_RESPONSES=1
# Retry delays (seconds) for a discipline after a timeout or a paused model; then the outline template is used.
DRAFT_RETRY_DELAYS=30,120,300
# Disciplines generated in parallel.
DRAFT_CONCURRENCY=3
# Vector search fragments with a lower similarity score are dropped (0 disables the cut-off).
# Not calibrated on live Yandex indexes yet: check the "dropped fragments" notices and adjust.
VECTOR_MIN_SCORE=0.3
# Optional settings for run_science.py. List only DOIs checked by a teacher or an expert.
SCIENCE_VERIFIED_DOIS=
# Enable only when your API key terms permit this use. Citation counts stay in the local application.
SCIENCE_SEMANTIC_SCHOLAR_ENABLED=0
SEMANTIC_SCHOLAR_API_KEY=
# University searches literature by discipline and topic once the topic list is ready.
LITERATURE_PARSER_ENABLED=1
# Optional expansion of search terms with the configured University model.
LITERATURE_USE_LLM=0
# Optional paid Yandex Search API for university and library catalogs.
LITERATURE_YANDEX_SEARCH=0
YANDEX_SEARCH_API_KEY=
# Business uses open job postings from Rostrud and Yandex Careers by default.
PUBLIC_VACANCIES_ENABLED=1
EMPLOYER_CAREERS_ENABLED=1

# User directories are read directly from the original files, without LLM calls.
TEACHERS_INDEX_ID=
EXPERTS_INDEX_ID=
# Optional legacy directory. Existing accounts sign in at /teacher.
PROGRAM_HEADS_INDEX_ID=
# Local accounts for development and demo (APP_ENV=development only). See local_users.example.txt.
LOCAL_USERS_FILE=
# Alternative names for the content indexes (take precedence when filled).
PRIKLAD_INDEX_ID=
INTERVIEW_SKILLS_INDEX_ID=
MAX_INVALID_REDIRECTS=2
GAP_WEAK_WEIGHT=0.4
GAP_FRESHNESS_HALF_LIFE_YEARS=5
GAP_TARGET_INDEPENDENT_SOURCES=3
GAP_COVERED_THRESHOLD=0.7
BOUNDARY_CONFLICT_THRESHOLD=0.6
BOUNDARY_VIOLATION_THRESHOLD=0.5
HH_INDEX_ID=
BOOKS_INDEX_ID=
RPD_INDEX_ID=
# PostgreSQL for application state. Generate a random hexadecimal POSTGRES_PASSWORD for Docker Compose.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Port published by Docker Compose.
RPD_WEB_PORT=8080
# External address for invitation links in Docker, for example http://rpd.example.org:8080.
# Leave empty for http://localhost:<RPD_WEB_PORT>.
RPD_PUBLIC_ORIGIN=
APP_DATABASE_URL=postgresql://rpd:<POSTGRES_PASSWORD>@127.0.0.1:5432/rpd
# Optional SQL user adapter if both Yandex directories are unset.
USER_DATABASE_URL=
USER_SCHEMA_MODE=single
USERS_TABLE=users
TEACHERS_TABLE=teachers
EXPERTS_TABLE=experts
ID_COLUMN=id
EMAIL_COLUMN=email
PASSWORD_HASH_COLUMN=password_hash
DISPLAY_NAME_COLUMN=display_name
ROLE_COLUMN=role
USER_ROLES_TABLE=user_roles
USER_ROLE_USER_ID_COLUMN=user_id
USER_ROLE_VALUE_COLUMN=role
HASH_SCHEME=auto
ALLOW_REHASH_ON_LOGIN=false
SESSION_SIGNING_KEY=
# Leave empty to use the same PostgreSQL database as the application.
CHECKPOINT_URL=
# These two settings are for running Python on the host. Compose sets its own values.
PUBLIC_ORIGIN=http://localhost:8501
APP_ENV=development
