# Copy this file to .env and fill in values locally.
# Never commit or send .env; it contains the Yandex API key.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# For example, gpt://<folder-id>/aliceai-llm.
YANDEX_MODEL_URI=
# Optional. A blank value uses Alice AI LLM Flash in this folder.
YANDEX_MODEL_URI_UNIVERSITY=
YANDEX_MODEL_URI_SCIENCE=
YANDEX_MODEL_URI_BUSINESS=
YANDEX_VECTOR_STORE_ID_RPD=
YANDEX_VECTOR_STORE_ID_BOOKS=
YANDEX_VECTOR_STORE_ID_HH=
# Applied professional activities and interview techniques.
YANDEX_VECTOR_STORE_ID_PRIKLAD=
YANDEX_VECTOR_STORE_ID_INTERVIEW=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Optional settings for run_science.py. List only DOIs checked by a teacher or an expert.
SCIENCE_VERIFIED_DOIS=
# Enable only when your API key terms permit this use. Citation counts stay in the local application.
SCIENCE_SEMANTIC_SCHOLAR_ENABLED=0
SEMANTIC_SCHOLAR_API_KEY=

# New course workflow. Existing user database is accessed read-only.
APP_DATABASE_URL=sqlite+aiosqlite:///./data/application.sqlite
USER_DATABASE_URL=
USER_SCHEMA_MODE=single
USERS_TABLE=users
TEACHERS_TABLE=teachers
EXPERTS_TABLE=experts
ID_COLUMN=id
EMAIL_COLUMN=email
PASSWORD_HASH_COLUMN=password_hash
DISPLAY_NAME_COLUMN=display_name
ROLE_COLUMN=role
USER_ROLES_TABLE=user_roles
USER_ROLE_USER_ID_COLUMN=user_id
USER_ROLE_VALUE_COLUMN=role
HASH_SCHEME=auto
ALLOW_REHASH_ON_LOGIN=false
SESSION_SIGNING_KEY=
CHECKPOINT_URL=data/checkpoints.sqlite
PUBLIC_ORIGIN=http://localhost:8501
APP_ENV=development
